# Runtime and Prisma CLI connection to the Neon/PostgreSQL database.
# Use a dedicated non-production database for local development and tests.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"

# Keep pools bounded because each server instance owns a pool.
DATABASE_POOL_MAX="5"
DATABASE_CONNECTION_TIMEOUT_MS="5000"

# Optional, explicit opt-in for non-destructive database integration tests.
# Never point this at production or shared data.
TEST_DATABASE_URL="postgresql://USER:PASSWORD@TEST_HOST/TEST_DATABASE?sslmode=require"
